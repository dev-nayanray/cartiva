{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Soft",
	"slug": "section-surface",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/cover" ],
	"styles": {
		"color": {
			"background": "var:preset|color|surface",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50"
			}
		},
		"elements": {
			"heading": { "color": { "text": "var:preset|color|contrast" } },
			"link": { "color": { "text": "var:preset|color|contrast" } },
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" },
				":hover": { "color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" } }
			}
		}
	}
}
