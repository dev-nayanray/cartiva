{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Brand",
	"slug": "section-primary",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/cover" ],
	"styles": {
		"color": {
			"background": "var:preset|color|primary",
			"text": "var:preset|color|base"
		},
		"spacing": {
			"padding": {
				"top": "var:preset|spacing|50",
				"bottom": "var:preset|spacing|50"
			}
		},
		"elements": {
			"heading": { "color": { "text": "var:preset|color|base" } },
			"link": { "color": { "text": "var:preset|color|base" } },
			"button": {
				"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
				":hover": { "color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" } }
			}
		}
	}
}
